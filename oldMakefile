NAME = ircserv

NAME_BONUS = spamBot

# DIRECTORIES
SRC_DIR = src/
SRC_DIR_BONUS = bonus/src_bonus/
OBJ_DIR = obj/

# SOURCES
SRC =	main.cpp \
		class/Channel.cpp \
		class/Client.cpp \
		class/Cmd.cpp \
		class/Command.cpp \
		class/Server.cpp \
		tools/logScript.cpp \
		tools/split.cpp \
		tools/toSize_t.cpp

SRC_BONUS =	main_bonus.cpp \
			cmd.cpp \
			spamBot.cpp

OBJ = $(addprefix $(OBJ_DIR), $(SRC:.cpp=.o))

OBJ_BONUS = $(SRC_BONUS:.cpp=.o)

CFLAGS = -Werror -Wextra -Wall -g --std=c++98

all:	$(NAME)

$(NAME): $(OBJ)
	c++ $(CFLAGS) $(OBJ) -o $(NAME)
	
bonus: $(OBJ_BONUS)
	c++ $(CFLAGS) $(OBJ_BONUS) -o $(NAME_BONUS)

$(OBJ_DIR)%.o: $(SRC_DIR)%.cpp
	@mkdir -p $(dir $@)
	c++ $(CFLAGS) -c $< -o $@

clean:
		rm -f $(OBJ)

fclean: clean
		rm -f $(NAME)
		rm -f $(NAME_BONUS)
		rm -f irc.log

re: fclean all

.PHONY: all clean fclean re bonus
